{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "theme": "abyss",
  "background": { "gradient": ["#0b1828", "#04090f"], "angle": 155 },
  "terminal_padding": [16, 14],
  "terminal_opacity": 0.97,
  "divider": { "width": 1, "color": "border" },
  "preview": "layouts/abyss.svg",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 272 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": { "px": 48 },
          "window_drag": true,
          "content": { "mod": "abyss-chrome" }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": { "weight": 1 },
              "min": 90,
              "content": { "mod": "spaces" }
            },
            {
              "id": "agents",
              "type": "block",
              "size": { "weight": 1 },
              "min": 90,
              "content": { "mod": "agents" }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": { "px": 98 },
          "content": { "mod": "abyss-chrome", "props": { "footer": true } }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 44 },
          "window_drag": true,
          "content": { "mod": "abyss-tabs" }
        },
        {
          "id": "work-main",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "work-body",
              "type": "row",
              "padding": 10,
              "gap": 10,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 10,
                      "radius": 12,
                      "background": "#0e1621f2",
                      "lone": true,
                      "border": { "width": 1, "color": "#2e3d4c" },
                      "focus": { "width": 1, "color": "#57e7c1" },
                      "header": {
                        "content": { "mod": "abyss-pane" },
                        "height": 32,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": { "px": 380 },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": { "mod": "files" }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": { "mod": "changes" }
                        },
                        {
                          "id": "herd-tasks",
                          "type": "block",
                          "content": { "mod": "herd-tasks" }
                        },
                        {
                          "id": "herd-bots",
                          "type": "block",
                          "content": { "mod": "herd-bots" }
                        },
                        {
                          "id": "herd-ops",
                          "type": "block",
                          "content": { "mod": "herd-ops" }
                        },
                        {
                          "id": "herd-usage",
                          "type": "block",
                          "content": { "mod": "herd-usage" }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "dock-lane",
              "type": "column",
              "size": { "px": 84 },
              "children": []
            }
          ],
          "floating": [
            {
              "id": "botdock",
              "content": { "mod": "herd-bots", "props": { "dock": true } },
              "edge": "bottom",
              "align": "center"
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": { "px": 30 },
          "content": { "mod": "abyss-status" }
        }
      ]
    }
  ]
}
